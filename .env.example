# LLM provider configuration - free-tier only, no paid keys are ever used.
#
# get_llm_client() builds an ordered chain of free-tier model attempts from whatever's set
# below (Gemini models, then Groq if configured, then a local Ollama server if configured),
# and walks it on every request: a model that's quota-exhausted, overloaded, or times out is
# skipped in favor of the next one. Leave everything empty to run with the built-in mock LLM
# client (no API calls, no key needed, deterministic placeholder output).

# Gemini: comma-separated, tried in order. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.6-flash,gemini-flash-lite-latest,gemini-flash-latest,gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash

# Groq (optional): a second, independent free provider, appended to the end of the chain only
# if GROQ_API_KEY is set. Get a free key at https://console.groq.com/keys - check
# https://console.groq.com/docs/models for the current free model lineup if GROQ_MODEL below
# is ever retired.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (optional): a local model server, the last fallback - zero API key, zero network
# dependency. Only added to the chain if OLLAMA_MODEL is set, and only useful if you actually
# have Ollama running locally (https://ollama.com) with that model pulled.
OLLAMA_MODEL=

# Dev-only response cache: set to 1 to cache (system_prompt, user_prompt) -> response on disk
# in data/llm_cache/ (gitignored). A cache hit skips every provider entirely - handy for fast
# iteration, but never enable this in a real demo, since it would silently mask any inference
# actually happening (or not) for a given input. Never read from a secrets store (only ever
# from a real local .env like this one) - see README's "Deploying" section.
LLM_CACHE=0

# --- Public-demo quota protection (see README's "Deploying" section) ----------------------

# Optional: if set, gates the whole app behind this shared password. Leave empty for no gate
# (the default - fine for local dev or a private deployment).
DEMO_PASSWORD=

# Per-browser-session cap on real generation attempts (ask() + "Export edit brief" combined) -
# protects one shared free-tier key on a public demo link. 20 is plenty for local dev/testing.
MAX_GENERATIONS_PER_SESSION=20

# --- Ad inspiration (optional, see README's "Ad inspiration" section) ----------------------
#
# Not an AI feature - a plain HTTP call to Meta's own public, official Ad Library API
# (https://www.facebook.com/ads/library/api) to show what ads are currently running in a
# brand's niche, as inspiration. Leave empty to leave the sidebar panel disabled. Requires a
# Meta Developer App with Ad Library API access - check Meta's current docs when setting this
# up, since the exact auth flow and field availability have changed over time.
META_AD_LIBRARY_ACCESS_TOKEN=
# ISO country code to scope ad searches to. Defaults to IN if unset.
AD_LIBRARY_COUNTRY=IN

# --- Competitor ad research (optional, see README's "Competitor ad research" section) ------
#
# Given a category (not a brand name), identifies the top competing brands, then pulls each
# one's ads from Meta's Ad Library (reuses META_AD_LIBRARY_ACCESS_TOKEN above) and from
# Google's Ads Transparency Center via Apify's google-ads-scraper actor - a paid, pay-per-event
# third-party scraper (~$0.90/1000 ads, roughly a few cents per category search at the limit
# below), not an official Google API. Finding a brand's Ads Transparency advertiser page has no
# public API at all, so this uses Gemini's Google Search grounding to find it - the Google side
# specifically needs GEMINI_API_KEY (grounding is Gemini-only, not available via Groq/Ollama),
# separately from APIFY_API_TOKEN. Missing either, or a brand's page just not being found,
# degrades gracefully: that brand (or the whole Google side) is skipped, Meta results still show.
APIFY_API_TOKEN=
# Max ads scraped per brand on the Google side - a direct cost/latency knob.
GOOGLE_ADS_RESULTS_LIMIT=15
# APIFY_API_TOKEN also unlocks a second thing: if META_AD_LIBRARY_ACCESS_TOKEN above isn't set,
# core/meta_ads.py falls back to scraping Meta's Ad Library via Apify's
# curious_coder/facebook-ads-library-scraper actor instead - useful since the official Meta
# token requires a Meta Developer App + App Review, which not every setup has been through.
# Always prefers the official token when it's set (free, no scraping/ToS risk); this is a
# fallback, not a replacement. Same cost model as the Google side (~$0.75/1000 ads).
META_ADS_APIFY_RESULTS_LIMIT=15
