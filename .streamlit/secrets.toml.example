# Streamlit Community Cloud reads secrets from here (Settings -> Secrets in the app dashboard,
# which writes exactly this file server-side) - there's no .env file on the hosted platform.
# Locally, app.py's load_dotenv() + .env already covers everything; you only need a real
# .streamlit/secrets.toml (copy this file there and remove the .example suffix) if you want to
# test the secrets path itself locally. The real file is gitignored - never commit it.

GEMINI_API_KEY = "your-gemini-api-key"

# Optional - comma-separated, same format/default as .env's GEMINI_MODELS.
# GEMINI_MODELS = "gemini-3.6-flash,gemini-flash-lite-latest,gemini-flash-latest,gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash"

# Optional - a second free provider (see README's "LLM provider" section).
# GROQ_API_KEY = "your-groq-api-key"
# GROQ_MODEL = "llama-3.3-70b-versatile"

# Optional - if set, gates the whole app behind this shared password (see README's "Deploying"
# section) - protects a public demo link's free-tier key from being hammered by strangers.
# DEMO_PASSWORD = "choose-something-only-people-you-share-the-link-with-would-know"
